<?xml version="1.0" encoding="utf-8"?>
<!-- UpgradeCode stays fixed so a newer MSI replaces this install. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="V4JB"
           Manufacturer="Stupid Systems LLC"
           Version="$(var.ProductVersion)"
           UpgradeCode="DC4BA5F0-8340-4999-940A-D4A6B49D26B7"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of V4JB is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Icon Id="V4jbIcon" SourceFile="!(bindpath.Icon)icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="V4jbIcon" />

    <!-- Feature tree: both on by default, either can be cleared, Browse changes that feature's folder. -->
    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CompanyFolder" Name="Stupid Systems LLC">
        <Directory Id="INSTALLFOLDER" Name="V4JB">
          <Component Id="Standalone" Guid="*">
            <File Id="StandaloneExe" Name="V4JB.exe" Source="!(bindpath.Standalone)V4JB.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="V4JB">
        <!-- HKCU keypath is what MSI requires for a Start menu shortcut. -->
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="StartMenu"
                    Directory="ProgramMenuDir"
                    Name="V4JB"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="V4jbIcon"
                    Target="[INSTALLFOLDER]V4JB.exe" />
          <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\Stupid Systems LLC\V4JB"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonFiles6432Folder">
      <Directory Id="VST3DIR" Name="VST3">
        <Directory Id="Vst3Bundle" Name="V4JB.vst3" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Vst3Files" Directory="Vst3Bundle">
      <Files Include="!(bindpath.Vst3)**" />
    </ComponentGroup>

    <Feature Id="Vst3Feature" Title="VST3" Level="1" ConfigurableDirectory="VST3DIR"
             Description="VST3 plugin. Default folder is Common Files\VST3.">
      <ComponentGroupRef Id="Vst3Files" />
    </Feature>

    <Feature Id="StandaloneFeature" Title="Standalone" Level="1" ConfigurableDirectory="INSTALLFOLDER"
             Description="Standalone app and Start menu shortcut. Default folder is Program Files\Stupid Systems LLC\V4JB.">
      <ComponentRef Id="Standalone" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
